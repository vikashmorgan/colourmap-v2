{
  "name": "colourmap-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/gen-changelog.ts && next dev",
    "build": "bun scripts/gen-changelog.ts && next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "bun scripts/gen-changelog.ts && tsc --noEmit",
    "format": "biome check --write .",
    "test": "bun scripts/gen-changelog.ts && NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "bun scripts/gen-changelog.ts && NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage && node scripts/check-coverage-thresholds.mjs",
    "coverage": "bun scripts/gen-changelog.ts && NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage && bun scripts/coverage-gate.mjs",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:e2e": "playwright test",
    "collab:setup": "bash scripts/setup-collab.sh",
    "collab:doctor": "bash scripts/collab-doctor.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "policy:architecture-boundaries": "bun scripts/check-architecture-policy.ts",
    "policy:lockfile": "bash scripts/check-lockfile-policy.sh",
    "policy:protected-paths": "bash scripts/check-protected-paths.sh",
    "policy:pr-scope": "bash scripts/check-pr-scope.sh",
    "policy:spec-drift": "bash scripts/check-spec-drift.sh",
    "policy:test-drift": "bash scripts/check-test-drift.sh",
    "policy:test-pairs": "bun scripts/check-test-pairs.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/react": "^3.0.144",
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.184.0",
    "ai": "^6.0.142",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "kokoro-js": "^1.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "postgres": "^3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.0.1",
    "lefthook": "^2.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
